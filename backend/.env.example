DJANGO_SECRET_KEY=change-this-for-a-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SESSION_COOKIE_AGE=1209600
# Production: set the public frontend origin(s), e.g. https://studio.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://studio.example.com
DJANGO_LOG_LEVEL=INFO

# Configure PostgreSQL for shared/deployed environments. If unset, local SQLite is used.
# POSTGRES_DB=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

VIDEO_RENDER_MODE=inline
# Async production mode requires: pip install -r requirements-async.txt
# and CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# VIDEO_RENDER_MODE=celery
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
MEDIA_ROOT=media
REMOTION_PROJECT_DIR=../remotion
REMOTION_RENDER_TIMEOUT=1200
NODE_EXECUTABLE=node
PIPER_EXECUTABLE=piper
# Optional local Piper voice model; narration upload works without Piper.
# PIPER_MODEL_PATH=C:\models\pt_PT-model.onnx
PIPER_TIMEOUT=180

# Optional Pollinations API key; image URL generation is currently documented as keyless.
POLLINATIONS_API_KEY=
POLLINATIONS_TIMEOUT=120
POLLINATIONS_MAX_IMAGE_BYTES=15728640

AGENT_API_BASE_URL=https://api.openai.com/v1/chat/completions
AGENT_API_KEY=
AGENT_MODEL=
AGENT_TIMEOUT=45
